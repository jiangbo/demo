.{
    // 开始游戏
    .{
        .key = .start,
        .target = .start,
        .mapId = 1,
        .facing = .down,
    },
    // 城市回家
    .{
        .key = .cityToHome,
        .target = .homeToCity,
        .mapId = 2,
        .facing = .down,
    },
    // 家里出门
    .{
        .key = .homeToCity,
        .target = .cityToHome,
        .mapId = 1,
        .facing = .up,
    },
    // 城市进入武器铺
    .{
        .key = .cityToWeaponShop,
        .target = .weaponShopToCity,
        .mapId = 2,
        .facing = .down,
    },
    // 武器铺返回城市
    .{
        .key = .weaponShopToCity,
        .target = .cityToWeaponShop,
        .mapId = 3,
        .facing = .up,
    },
    // 城市进入药店
    .{
        .key = .cityToPotionShop,
        .target = .potionShopToCity,
        .mapId = 2,
        .facing = .down,
    },
    // 药店返回城市
    .{
        .key = .potionShopToCity,
        .target = .cityToPotionShop,
        .mapId = 4,
        .facing = .up,
    },
    // 城市进入酒店
    .{
        .key = .cityToHotel,
        .target = .hotelToCity,
        .mapId = 2,
        .facing = .down,
    },
    // 酒店返回城市
    .{
        .key = .hotelToCity,
        .target = .cityToHotel,
        .mapId = 5,
        .facing = .up,
    },
    // 城市前往森林
    .{
        .key = .cityToForest,
        .target = .forestToCity,
        .mapId = 2,
        .facing = .up,
        .progress = 4,
    },
    // 森林返回城市
    .{
        .key = .forestToCity,
        .target = .cityToForest,
        .mapId = 7,
        .facing = .down,
    },
    // 进入战斗
    .{
        .key = .battle,
        .target = .battle,
        .mapId = 6,
        .facing = .down,
    },
    // 森林进入宫殿
    .{
        .key = .forestToPalace,
        .target = .palaceToForest,
        .mapId = 7,
        .facing = .up,
        .progress = 10,
    },
    // 宫殿返回森林
    .{
        .key = .palaceToForest,
        .target = .forestToPalace,
        .mapId = 8,
        .facing = .up,
    },
}
